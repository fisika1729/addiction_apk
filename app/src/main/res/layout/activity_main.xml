<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:scrollbars="vertical"
    android:orientation="vertical"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/text_bright"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Timed screen-off control over every app"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/needs_write_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/grant_write_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_grant_write"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/grant_write_btn"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_sel_1min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/app_sel_1min"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_sel_2min"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/app_sel_2min"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_sel_custom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="@string/widget_custom"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/app_btn_start"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_btn_stop"
                    android:textAllCaps="false" />
            </LinearLayout>

            <Switch
                android:id="@+id/repeat_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/repeat_label"
                android:textColor="@color/text_bright"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_off_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent"
                android:text="@string/off_now_label"
                android:textAllCaps="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/lang_row_title"
                android:textColor="@color/warn"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_lang_sys"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="@string/lang_sys"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_lang_en"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="@string/lang_en"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_lang_hi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="@string/lang_hi"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_lang_ta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/chip_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="@string/lang_ta"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/howto_title"
                android:textColor="@color/warn"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/howto_text"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
