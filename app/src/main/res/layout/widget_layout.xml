<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/status_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical|start"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn1min"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:text="1min"
        android:textAllCaps="false"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:layout_marginStart="4dp" />

    <Button
        android:id="@+id/btn2min"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:text="2min"
        android:textAllCaps="false"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:layout_marginStart="3dp" />

    <Button
        android:id="@+id/btnCustom"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:text="@string/widget_custom"
        android:textAllCaps="false"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:layout_marginStart="3dp" />

    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="72dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/toggle_btn_bg"
        android:padding="0dp"
        android:text="@string/widget_start"
        android:textAllCaps="false"
        android:textColor="@color/text_bright"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginStart="3dp" />
</LinearLayout>
